<%- include('partials/header') %>

<div class="container-fluid">
  <div class="row">
    <!-- Sidebar -->
    <nav class="col-md-auto sidebar">
      <div class="position-sticky pt-3">
        <ul class="nav flex-column">
          <li class="nav-item">
            <a class="nav-link" href="/dashboard">
              <i class="fas fa-chart-line"></i>
              Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link active" href="/transactions/add">
              <i class="fas fa-plus-circle"></i>
              Add Transaction
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/transactions/list">
              <i class="fas fa-list-ul"></i>
              All Transactions
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/upload">
              <i class="fas fa-cloud-upload-alt"></i>
              Bulk Upload
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/export">
              <i class="fas fa-file-export"></i>
              Export Reports
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/audit">
              <i class="fas fa-history"></i>
              Audit Logs
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/settings">
              <i class="fas fa-cog"></i>
              Settings
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/auth/logout">
              <i class="fas fa-sign-out-alt"></i>
              Logout
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="main-content">
      <div class="page-header fade-in">
        <h1>
          <i class="fas fa-plus-circle"></i>
          Add New Transaction
        </h1>
      </div>

      <div class="row justify-content-center fade-in">
        <div class="col-md-8">
          <div class="card shadow-lg">
            <div class="card-header">
              <i class="fas fa-file-invoice-dollar"></i>
              Transaction Details
            </div>
            <div class="card-body">
              <form method="POST" action="/transactions/add">
                <div class="mb-3">
                  <label class="form-label">
                    <i class="fas fa-dollar-sign"></i>
                    Amount ($)
                  </label>
                  <input type="number" step="0.01" name="amount" class="form-control" placeholder="Enter amount" required>
                </div>

                <div class="mb-3">
                  <label class="form-label">
                    <i class="fas fa-calendar-alt"></i>
                    Transaction Time
                  </label>
                  <input type="datetime-local" name="transaction_time" class="form-control" required>
                </div>

                <div class="mb-3">
                  <label class="form-label">
                    <i class="fas fa-mobile-alt"></i>
                    Device Type
                  </label>
                  <select name="device_type" class="form-select" required>
                    <option value="">Select device...</option>
                    <option value="Mobile">Mobile</option>
                    <option value="Desktop">Desktop</option>
                    <option value="Tablet">Tablet</option>
                    <option value="POS">POS Terminal</option>
                  </select>
                </div>

                <div class="mb-3">
                  <label class="form-label">
                    <i class="fas fa-map-marker-alt"></i>
                    Location
                  </label>
                  <input type="text" name="location" class="form-control" placeholder="e.g., New York, USA" required>
                </div>

                <div class="d-grid gap-2">
                  <button type="submit" class="btn btn-primary">
                    <i class="fas fa-paper-plane"></i>
                    Submit Transaction
                  </button>
                  <a href="/dashboard" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Back to Dashboard
                  </a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<script>
// Show toast notifications based on server response
window.addEventListener('load', function() {
  <% if (error) { %>
    if (typeof toast !== 'undefined') {
      toast.error('Error', '<%= error %>', 5000);
    }
  <% } %>
  
  <% if (success && prediction && probability) { %>
    if (typeof toast !== 'undefined') {
      const prediction = '<%= prediction %>';
      const probability = parseFloat('<%= probability %>');
      
      if (prediction === 'fraud' && probability >= 70) {
        toast.error(
          'High Risk Fraud Detected!',
          '<%= success %> - Fraud probability: <%= probability %>%',
          7000
        );
      } else if (prediction === 'fraud') {
        toast.warning(
          'Medium Risk Transaction',
          '<%= success %> - Fraud probability: <%= probability %>%',
          6000
        );
      } else {
        toast.success(
          'Transaction Added Successfully!',
          '<%= success %> - Fraud probability: <%= probability %>%',
          5000
        );
      }
    }
  <% } %>
});
</script>

<%- include('partials/footer') %>